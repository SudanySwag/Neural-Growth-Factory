:root {
}

.sidebarButton {
    background-color: rgb(63, 113, 253);
    -unity-font-definition: url("project://database/Assets/Fonts/Bangle-Normal.ttf?fileID=12800000&guid=d54fe27f7341c054baa440ddf5a41d89&type=3#Bangle-Normal");
    -unity-font-style: bold;
    margin-left: 0;
    margin-right: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    text-shadow: 0 0 0 rgb(255, 255, 255);
    height: 8%;
    font-size: 200%;
}
