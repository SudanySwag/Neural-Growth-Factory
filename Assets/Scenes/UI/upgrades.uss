:root {
}

#Upgrades > .unity-base-field__input > #contentContainer {
    height: 100%;
}

.buttonPanel {
    flex-direction: row;
    width: 53%;
    align-self: flex-end;
    transition-property: opacity;
    transition-timing-function: ease-out-sine;
    transition-duration: 5s;
    flex-grow: 1;
}

.upgradeButton {
    align-self: center;
    width: 12%;
    height: 12%;
    margin-left: 88%;
    transition-property: margin-left, opacity;
    transition-duration: 0.3s, 0s;
    transition-timing-function: ease-in-out-sine, ease;
}

.upgradeButton:selected {
    margin-left: 0%;
}

.upgradePanel {
    background-color: rgba(0, 0, 0, 0.78);
    flex-grow: 1;
}

#Upgrades > #Off {
    translate: 0% 0;
    position: absolute;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: 44%;
    opacity: 0;
}

#Upgrades > #Off:selected {
    translate: -100% 0;
}

#Upgrades > .buttonPanel > .upgradeButton > .unity-radio-button__input {
    justify-content: center;
    scale: 5 5;
}

#Upgrades > .buttonPanel > .upgradeButton > .unity-radio-button__input > .unity-radio-button__checkmark-background {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    justify-content: center;
}

#Upgrades > .buttonPanel > .upgradeButton > .unity-radio-button__input > .unity-radio-button__checkmark-background > #unity-checkmark {
}

.node {
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    background-color: rgba(17, 10, 134, 0.53);
    width: 50px;
    height: 50px;
}
